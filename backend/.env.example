# Application Configuration
APP_NAME=AI Data Analyst Agent
APP_ENV=development

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./data_analyst.db

# JWT Authentication
JWT_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password Reset & Email Configuration (Gmail SMTP)
# When SMTP is not configured, password reset tokens are logged safely in development mode.
# Note: For Gmail SMTP, enable 2-Step Verification on your Google Account and generate a 16-character App Password.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=20
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dataanalystagent@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=dataanalystagent@gmail.com
SMTP_FROM_NAME=AI Data Analyst Agent
SMTP_TLS=true

# Support Contact Details
SUPPORT_EMAIL=dataanalystagent@gmail.com
SUPPORT_PHONE=9021964018

# File Storage Configuration
MAX_UPLOAD_SIZE_MB=50
STORAGE_DIR=storage
